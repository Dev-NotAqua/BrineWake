(fn Scan ()
  (bind wz (Variables|Default|GetWaterZ))
  (bind pawn (Game|GetPlayerPawn :PlayerIndex 0))
  (bind acts (Actor|GetAllActorsOfClass :ActorClass "/Script/Engine.Actor"))
  (for a acts
    (if (and (!= a pawn) (not (Utilities|Array|ContainsItem :TargetArray (Variables|Default|GetSeen) :ItemToFind a)))
      (bind (org ext) (Collision|GetActorBounds :self a :bOnlyCollidingComponents false :bIncludeFromChildActors false))
      (bind big (select (> (.x ext) (.y ext)) (.x ext) (.y ext)))
      (if (and (and (< (- (.z org) (.z ext)) (- wz 25.0)) (> (+ (.z org) (.z ext)) (+ wz 35.0))) (and (> big 45.0) (< big 6000.0)))
        (Utilities|Array|AddUnique :TargetArray (Variables|Default|GetSeen) :NewItem a)
        (if (Variables|Default|GetStarted)
          (Audio|PlaySoundatLocation :Sound "/Game/Brinewake/Audio/A_BW_Splash_Big.A_BW_Splash_Big" :Location (Math|Vector|MakeVector :X (.x org) :Y (.y org) :Z wz))
          (Niagara|SpawnSystematLocation :SystemTemplate "/Game/Brinewake/VFX/NS_BW_Splash.NS_BW_Splash" :Location (Math|Vector|MakeVector :X (.x org) :Y (.y org) :Z wz)))
        (for i (range 8)
          (if (or (or (and (> big 900.0) (or (or (== i 0) (== i 2)) (or (== i 4) (== i 6)))) (and (and (> big 250.0) (<= big 900.0)) (or (== i 0) (== i 4)))) (and (<= big 250.0) (== i 0)))
            (bind ang (+ (* 45.0 (Math|Conversions|ToFloat(Integer) i)) (Math|Random|RandomFloatinRange :Min -18.0 :Max 18.0)))
            (bind start (Math|Vector|MakeVector :X (+ (.x org) (* (Math|Trig|Cos(Degrees) ang) (* (.x ext) 1.3))) :Y (+ (.y org) (* (Math|Trig|Sin(Degrees) ang) (* (.y ext) 1.3))) :Z (+ wz 30.0)))
            (bind (hit ok) (Collision|LineTraceByChannel :Start start :End (Math|Vector|MakeVector :X (.x org) :Y (.y org) :Z (+ wz 30.0)) :TraceChannel "TraceTypeQuery1" :bTraceComplex true :DrawDebugType "None" :bIgnoreSelf true))
            (if ok
              (bind (b0 b1 tm dist loc ip nrm inrm pm ha hc) (Collision|BreakHitResult :Hit hit))
              (if (== ha a)
                (Niagara|SpawnSystemAttached :SystemTemplate "/Game/Brinewake/VFX/NS_BW_WaterSpray.NS_BW_WaterSpray" :AttachToComponent hc :AttachPointName "None" :Location (+ ip (* inrm 25.0)) :Rotation (Math|Rotator|MakeRotator :Yaw 0.0) :LocationType "KeepWorldPosition" :bAutoDestroy false :bAutoActivate true :PoolingMethod "None" :bPreCullCheck true))))))))
  (Variables|Default|SetStarted true))
