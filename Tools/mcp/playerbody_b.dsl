(event EventTick (DeltaSeconds)
  (bind ch (Game|GetPlayerCharacter :PlayerIndex 0))
  (Utilities|IsValid ch
    (:"Is Valid"
      (bind body (Variables|Default|GetBody))
      (if (not (Variables|Default|GetReady))
        (Transformation|AttachActorToActor :ParentActor ch :SocketName "None" :LocationRule "SnapToTarget" :RotationRule "SnapToTarget" :ScaleRule "KeepWorld" :bWeldSimulatedBodies false)
        (Transformation|SetActorRelativeLocation :NewRelativeLocation (Math|Vector|MakeVector :X -14.0 :Y 0.0 :Z -96.0) :bSweep false :bTeleport true)
        (Transformation|SetActorRelativeRotation :NewRelativeRotation (Math|Rotator|MakeRotator :Yaw -90.0) :bSweep false :bTeleport true)
        (Components|SkinnedMesh|HideBonebyName :self body :BoneName "head" :PhysBodyOption "PBO_None")
        (Variables|Default|SetState -1)
        (Variables|Default|SetReady true))
      (bind mv (Class|Character|GetCharacterMovement :self ch))
      (bind vel (Transformation|GetVelocity :self ch))
      (bind flat (Math|Vector|VectorLengthXY vel))
      (bind want (select (Movement|IsSwimming :self mv)
                   (select (> (Math|Vector|VectorLength vel) 70.0) 5 4)
                   (select (Movement|IsFalling :self mv) 3 (select (> flat 330.0) 2 (select (> flat 12.0) 1 0)))))
      (if (!= want (Variables|Default|GetState))
        (Variables|Default|SetState want)
        (switch int want
          (:0 (Components|Animation|PlayAnimation :self body :NewAnimToPlay "/Game/Brinewake/Characters/Anims/A_BW_Idle.A_BW_Idle" :bLooping true))
          (:1 (Components|Animation|PlayAnimation :self body :NewAnimToPlay "/Game/Brinewake/Characters/Anims/A_BW_Walk.A_BW_Walk" :bLooping true))
          (:2 (Components|Animation|PlayAnimation :self body :NewAnimToPlay "/Game/Brinewake/Characters/Anims/A_BW_Run.A_BW_Run" :bLooping true))
          (:3 (Components|Animation|PlayAnimation :self body :NewAnimToPlay "/Game/Brinewake/Characters/Anims/A_BW_Jump.A_BW_Jump" :bLooping true))
          (:4 (Components|Animation|PlayAnimation :self body :NewAnimToPlay "/Game/Brinewake/Characters/Anims/A_BW_Swim_Tread.A_BW_Swim_Tread" :bLooping true))
          (:5 (Components|Animation|PlayAnimation :self body :NewAnimToPlay "/Game/Brinewake/Characters/Anims/A_BW_Swim_Forward.A_BW_Swim_Forward" :bLooping true))
          (:Default (Components|Animation|PlayAnimation :self body :NewAnimToPlay "/Game/Brinewake/Characters/Anims/A_BW_Idle.A_BW_Idle" :bLooping true)))))
    (:"Is Not Valid")))
